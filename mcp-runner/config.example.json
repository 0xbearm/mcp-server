{
  "servers": {
    "python-ssh-mcp": {
      "mounts": [
        {
          "source": "~/.config/python-ssh-mcp/config.json",
          "target": "/root/.config/python-ssh-mcp/config.json",
          "read_only": true
        },
        {
          "source": "~/.ssh",
          "target": "/root/.ssh",
          "read_only": true
        }
      ]
    },
    "postgres-mcp": {
      "pass_env": [
        "DATABASE_URI"
      ],
      "env": {
        "LOG_LEVEL": "info"
      }
    },
    "ghidra-mcp": {
      "docker_args": [
        "--network=host"
      ]
    }
  }
}
